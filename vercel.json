{
  "version": 2,
  "public": true,
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    }
  ],
  "rewrites": [
    { "source": "/((?!.*\\.(js|css|json|png|jpg|svg|ico|html)$).*)", "destination": "/index.html" }
  ]
}