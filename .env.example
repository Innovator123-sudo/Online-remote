# TV Control Hub Environment Configuration
# Copy this file to .env and fill in your values

# Server Configuration
PORT=5000
NODE_ENV=development

# TV Discovery Mode: 'ssdp', 'manual', 'mock'
# Use 'manual' for cloud deployments
TV_DISCOVERY_MODE=ssdp

# Manual TV Configuration (JSON array)
# Example: [{"name":"My TV","ip":"192.168.1.100","model":"Samsung TV"}]
TVS_CONFIG='[{"name":"My TV","ip":"192.168.1.100","model":""}]'

# Enable demo/mock TVs (set to false in production)
ENABLE_MOCK_TVS=false

# API Security
API_KEY=your-secure-api-key-here
ALLOWED_ORIGINS=http://localhost:5000,https://yourdomain.com

# WebSocket Configuration (optional, for separate WebSocket server)
WS_PORT=5002
WS_API_KEY=your-websocket-api-key
WS_URL=ws://localhost:5000

# Bridge Configuration (for local-bridge.js)
BRIDGE_MODE=standalone
BRIDGE_PORT=8080
CLOUD_SERVER=ws://localhost:5000
USE_SECURE_WS=false
