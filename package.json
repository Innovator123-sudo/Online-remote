{
  "name": "online-remote",
  "version": "3.1.0",
  "description": "Gesture TV remote: static site, cloud ADB relay, home helper with TV-protocol + ADB.",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "start": "node helper.js",
    "helper": "node helper.js",
    "cloud-server": "node facilities/remote-cloud-server.js",
    "cloud-bridge": "node facilities/remote-bridge.js",
    "docker:build": "docker build -t tv-remote facilities/",
    "docker:cloud": "docker-compose -f facilities/docker-compose.cloud.yml up",
    "docker:bridge": "docker-compose -f facilities/docker-compose.cloud.yml up bridge-agent",
    "docker:server": "docker-compose -f facilities/docker-compose.cloud.yml up cloud-server"
  },
  "license": "MIT",
  "dependencies": {
    "androidtv-remote": "^1.0.10",
    "express": "^5.2.1",
    "ws": "^8.21.3"
  }
}
