{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE"
  },
  "deploy": {
    "startCommand": "node remote-cloud-server.js",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10,
    "healthcheckPath": "/",
    "healthcheckTimeout": 100,
    "startTimeout": 360,
    "environments": [
      {
        "name": "production",
        "variables": {
          "PORT": "5000",
          "NODE_ENV": "production"
        }
      }
    ]
  }
}